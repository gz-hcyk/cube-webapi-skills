<?xml version="1.0" encoding="utf-8"?>
<CubeSetting>
  <!-- 必须是 HS256: 两段。只写在 appsettings.json 不会生效。 -->
  <JwtSecret>HS256:approval-demo-not-for-production</JwtSecret>
  <CorsOrigins>*</CorsOrigins>
  <Copyright>通用审批示例</Copyright>
  <LoginTip>审批示例。演示账号见 IMPLEMENTATION.md，不在登录页展示。</LoginTip>
</CubeSetting>
