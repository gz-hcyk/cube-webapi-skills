<?xml version="1.0" encoding="utf-8"?>
<CubeSetting>
  <!-- 必须是 HS256: 两段。只写在 appsettings.json 不会生效。 -->
  <JwtSecret>HS256:equipment-ledger-demo-not-for-production</JwtSecret>
  <CorsOrigins>*</CorsOrigins>
  <Copyright>设备台账示例</Copyright>
  <LoginTip>内部设备台账。演示账号见项目 README，不在登录页展示。</LoginTip>
</CubeSetting>
