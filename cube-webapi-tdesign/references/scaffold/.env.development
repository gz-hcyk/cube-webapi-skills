# 打包路径
VITE_BASE_URL = /

# ── 后端基址（★ 技能 HTTP 层唯一读取的两个变量，见 assets/core/api/http.ts）──────────────
# 同源部署（dev 走 vite proxy、生产走 Nginx 反代）→ 两个都留空，实体接口自动落 `/api`。
# dev 下的**真实后端地址**由 vite proxy 的 target 决定：`VITE_API_TARGET`（默认 127.0.0.1:5052）。
# 分离部署（前端不经 proxy 直连后端）→ 填后端根地址；⚠️ 写 IP / 域名，**勿写 localhost**。
# VITE_SERVER_BASE = http://127.0.0.1:5052
# VITE_API_BASE    = http://127.0.0.1:5052/api

# ⚠️ 以下三项来自 tdesign-starter 模板，**本技能链路不读取**（http.ts 只认上面两个 + VITE_API_TARGET），
#    保留仅为兼容模板形态，改它们不会生效。
VITE_IS_REQUEST_PROXY = true
VITE_API_URL = https://service-exndqyuk-1257786608.gz.apigw.tencentcs.com
VITE_API_URL_PREFIX = /api