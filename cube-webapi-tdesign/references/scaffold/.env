# 打包路径 根据项目不同按需配置
VITE_BASE_URL = /

# ── 后端基址（★ 技能 HTTP 层唯一读取的两个变量，见 assets/core/api/http.ts）──────────────
# 同源部署（dev 走 vite proxy、生产走 Nginx 反代）→ 两个都留空，实体接口自动落 `/api`。
# 分离部署 → 填后端根地址；⚠️ 写 IP / 域名，**勿写 localhost**（见铁律 H3）。
# VITE_SERVER_BASE = https://api.example.com
# VITE_API_BASE    = https://api.example.com/api

# ⚠️ 以下三项来自 tdesign-starter 模板，**本技能链路不读取**（http.ts 只认上面两个），
#    保留仅为兼容模板形态，改它们不会生效。
VITE_IS_REQUEST_PROXY = true
VITE_API_URL = https://service-bv448zsw-1257786608.gz.apigw.tencentcs.com
VITE_API_URL_PREFIX = /api